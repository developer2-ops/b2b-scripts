_FMnf3Esg.mL7vkwrAEn636pn_N7nAyNhoZElx_iCjMYldFnoPkCkg.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-image se-l-default\" id=\"SE-3ee1fcaa-b769-4465-ae24-90f0da253af6\">\n                    <div class=\"se-component-content se-component-content-extend\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" >\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-3ee1fcaa-b769-4465-ae24-90f0da253af6\", \"src\" : \"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfMTE5/MDAxNjk2NTYyMjE1MDEy.mUPYYYg3iekDwMhEbd8IA_WbeY4XTGp8tqwT-X8E_fwg.npxK39yiGeMg_Pj6ps6Pj-udeSuz9Eq2v6RPNlNouE4g.PNG/image.png\", \"originalWidth\" : \"928\", \"originalHeight\" : \"352\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfMTE5/MDAxNjk2NTYyMjE1MDEy.mUPYYYg3iekDwMhEbd8IA_WbeY4XTGp8tqwT-X8E_fwg.npxK39yiGeMg_Pj6ps6Pj-udeSuz9Eq2v6RPNlNouE4g.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-174c4ff8-e597-4894-baf2-155357310183\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-dfd7c328-de0a-4355-bef8-1be19c84446e\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b4c-63fc-11ee-bb49-eb4409975f8f\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-15abd65c-9242-4696-bb00-2264eaa4b723\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b4d-63fc-11ee-bb49-d913cc6644f8\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-63f89062-df9a-4d70-8292-9432da12569a\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b4f-63fc-11ee-bb49-5dc12057f27b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9243e172-1ed8-4554-87eb-81d2921b6815\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b51-63fc-11ee-bb49-8746fbf7ecfd\">아마 이 글을 읽은 분들도 제가 소개한 부업을 최소 1개는 보셨을 겁니다. &quot;해야지&quot; 라고 생각한것 중에 몇개를 해보셨나요? (혼내는거 아닙니다 ㅎㅎ) 저는 이런걸 &quot;해야지&quot; 병이라고 부릅니다. &quot;해야지, 해야지&quot; 하는데 결국 못하는 거죠. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9cd8f923-4ada-44e3-92b3-f8cd210102c4\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b53-63fc-11ee-bb49-53cf83c03ef7\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-07c4c31b-a60d-48b5-ab71-13b1ed4a4bae\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b55-63fc-11ee-bb49-b5bffb4c5e0c\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c86512ce-00a5-40e7-ace7-c4f2d519231f\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b57-63fc-11ee-bb49-75aaba967207\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d7914503-cbbb-4836-bf3a-3bc3fee7d8b6\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b59-63fc-11ee-bb49-41d822aba6ad\">오늘 글에서는 이 &quot;해야지&quot; 병을 치료하는 방법을 알려드리겠습니다. 제가 지금 막 두달간 걸린 &quot;해야지&quot; 병을 치료했거든요. 아마 &quot;이 부업 진짜 해야지&quot; 라고 생각했다가 못하고 있는 &quot;해야지&quot;병 환자(표현이 격한점 양해 부탁드립니다ㅎㅎ) 분들은 이 글을 읽으시면 바로 치료가 되실겁니다. 제가 그랬거든요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2d006785-f568-444f-b8ae-3e1c1be21602\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b5b-63fc-11ee-bb49-7114ab33ce36\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-894875c1-5f0f-4598-8d78-55efc3c70c7b\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b5c-63fc-11ee-bb49-e1d147885a0d\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-efb37fa1-e333-4fd9-ae23-6d969d5f1ece\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf0b5d-63fc-11ee-bb49-abe55e4abdf5\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4021210c-c3d9-4271-97b5-7e0a91f2bc71\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf316f-63fc-11ee-bb49-abbf91ca1187\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-15210059-bc81-4a69-993b-08944ab85151\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3171-63fc-11ee-bb49-9bf036f2d156\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0c659a11-5029-4127-b37e-c9a2a28e01ab\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3173-63fc-11ee-bb49-1fb525ec1297\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b82ad080-e12c-4306-9fbc-83d4f3392b50\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3175-63fc-11ee-bb49-7719799564b2\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cce75916-c30b-4cb6-b9b7-46e50ff1cef0\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3177-63fc-11ee-bb49-e53b6e461a3b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0b5a8c3d-779b-4cb7-a2fd-d5f24c48e32b\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3179-63fc-11ee-bb49-415ba6a4d46a\">종종 저도 오해를 받는데요. 영상에서 보시면, 제가 의지력과 실행력이 개 쩔어 보이는데 그렇지 않습니다. 원래 영상이란건 좋은 모습만 보여주는거 아니겠어요? ㅎㅎ 속지마세요 ㅎㅎ</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2a4ffa7d-3277-415f-909f-2f8e7eec8111\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf317b-63fc-11ee-bb49-e96223f8364d\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-26ad38ea-0104-4d42-adaa-750719a58c99\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf317d-63fc-11ee-bb49-ad4346134a62\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-469ddc49-288c-48fc-803d-cd6a2b8e0ecd\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf317f-63fc-11ee-bb49-553f837e68a4\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-eb7743d5-11b1-431a-9cd6-f39b9e4d07c6\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3181-63fc-11ee-bb49-039009a87fa9\">저는 최근 두달간 &quot;해야지&quot; 병에 걸려있었습니다. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a821b80a-d30b-474e-9192-962193022abb\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3183-63fc-11ee-bb49-9fd8b9d7b9e8\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-348c064a-84a8-45d1-a4c0-b85692755e54\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3185-63fc-11ee-bb49-a1b1e8c377fa\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-331e8011-a9ee-42cc-9f9e-a52cf27795c9\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3187-63fc-11ee-bb49-cfcd253c3dfb\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2511c3c6-af93-47d3-8117-407c9aa0f774\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3189-63fc-11ee-bb49-cbf36a21f154\">그 중 첫번째로는, &quot;카페에 글 써야지&quot; 라고 생각하고 있었는데요. 몰랐는데 오늘 보니 제 마지막 카페 글이 벌써 한달 반이 넘었네요. 심지어 마지막 글은 강의 관련 글이고, 제 생각을 적는 글은 두달 가까이 됐어요. 두달동안이나 &quot;글 써야지&quot; 하고 있었던 겁니다. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-025c6d18-ce36-4885-8f0a-fc48fb2d9547\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf318b-63fc-11ee-bb49-eb9603b07f4b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-405a1cb8-8d13-41a6-adff-824b6508cf1b\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf3193-63fc-11ee-bb49-711823a3f7eb\"> </span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-74c63178-fe54-4be4-8b47-e40dc84893a2\">\n                    <div class=\"se-component-content se-component-content-extend\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" >\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-74c63178-fe54-4be4-8b47-e40dc84893a2\", \"src\" : \"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfMjY2/MDAxNjk2NTYxOTk5NTE2.FnVy9BSsBqH5b_DQoeRprBDL8nm6YqNnY2qdQdV1pLUg.Zo6rK4B6npRI72eZU_ZYeuuz-cLPTbBfXmfiM-f0Q34g.PNG/image.png\", \"originalWidth\" : \"1116\", \"originalHeight\" : \"267\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfMjY2/MDAxNjk2NTYxOTk5NTE2.FnVy9BSsBqH5b_DQoeRprBDL8nm6YqNnY2qdQdV1pLUg.Zo6rK4B6npRI72eZU_ZYeuuz-cLPTbBfXmfiM-f0Q34g.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-22b0c7a7-554c-4585-a40a-0128f7d4b4a4\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-1aadab66-99da-4ad1-be59-61a0d6339d8a\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf319b-63fc-11ee-bb49-bd7c37c3b194\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-689c79e2-9e06-477d-bdd6-4e6d2697e39a\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf319e-63fc-11ee-bb49-85b076695f9b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e5447bde-1c6d-4058-9f1f-49d26d0fe82c\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31a0-63fc-11ee-bb49-2bbd4962aa4b\">나름 핑계를 대보자면, 부업스파르타반 강의랑 블로그 강의 수정때문에 바빴구요. 나름 글을 쓰려고 카페에 와서 끄적거리긴 했어요. 임시글을 6개나 저장해 놓고 마음에 안 들어서 발행을 안했네요 ㅋㅋㅋㅋㅋㅋㅋㅋ</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-d839464f-1874-4e67-abc5-1fc5ae766747\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:702px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-d839464f-1874-4e67-abc5-1fc5ae766747\", \"src\" : \"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfODEg/MDAxNjk2NTYyODQ0MTUw._HpdaP3Y-GO0jVuTLE8aWK35FqrqhQcHca3SMMdkPeIg.NT3QpK2NY0jjCs8PUNYLQB_D6xeZ0k-Y6K-rMLhvZ6og.PNG/image.png\", \"originalWidth\" : \"702\", \"originalHeight\" : \"559\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfODEg/MDAxNjk2NTYyODQ0MTUw._HpdaP3Y-GO0jVuTLE8aWK35FqrqhQcHca3SMMdkPeIg.NT3QpK2NY0jjCs8PUNYLQB_D6xeZ0k-Y6K-rMLhvZ6og.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-444b7943-8ee7-44e6-aeea-f80b5d41b968\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d532cb7f-730a-43bb-ac64-731001f76a53\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31a3-63fc-11ee-bb49-4bed18cf4bc8\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-fae024d4-adf6-4b17-8603-bc646eaae735\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31a4-63fc-11ee-bb49-45c1c686f9ac\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7f7bf5fc-eb5a-40ec-8e86-8bbe61bb0002\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31a5-63fc-11ee-bb49-a398aca43124\">두번째로는, 블로그 강의와 플레이스 강의 수정을 9월 말까지 한다고 했는데요. 사실 아직도 다 못했어요;; (죄송합니다) 나름 핑계를 대 보자면, 처음에는 수정하고 싶은 몇가지 부분만 하려고 했는데요.......................막상 하다보니 마음에 안드는 구석이 많은거예요. 그래서 제 강의를 스스로 다시 다 들어보고, 자막도 좀 더 바꾸고, 영상도 다시 찍고....................어쩌고............하다보니 10월 초네요;;</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a3d4f5ed-3f76-4eae-bc7d-4d718ac4568d\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31a6-63fc-11ee-bb49-73690bc8fa49\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-82dcc793-fa94-4d9d-b4a6-473de4b0497d\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31a7-63fc-11ee-bb49-274c3d274634\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e2715250-a02e-491b-927b-7d505d0504d7\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31a8-63fc-11ee-bb49-8d43cdf3c937\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-71a5ef43-3c83-46ee-9c47-96eb9aa89fdf\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31aa-63fc-11ee-bb49-337af1a1a1d2\">플레이스 강의(지도부업 강의)도 문의가 많은데, 제가 지금 개편 하고 있거든요. 근데 또 막상 보니깐 수정하고 싶은게 많아요...........................보면 볼수록 더 수정하고 싶고.................거의 블랙홀이예요. </span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-2e621af1-2d8a-439f-801b-327d1833904d\">\n                    <div class=\"se-component-content se-component-content-extend\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" >\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-2e621af1-2d8a-439f-801b-327d1833904d\", \"src\" : \"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfNDIg/MDAxNjk2NTYzMDM3ODgz.wFgvtPBmZJFV0KPP1DLYI-_YzZrF0cnaSO_GJZ-gnVsg.5CyaZh3h-GOzPMUeot54Qsp600U4gxA0ojgidjS7CKkg.PNG/image.png\", \"originalWidth\" : \"1089\", \"originalHeight\" : \"382\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfNDIg/MDAxNjk2NTYzMDM3ODgz.wFgvtPBmZJFV0KPP1DLYI-_YzZrF0cnaSO_GJZ-gnVsg.5CyaZh3h-GOzPMUeot54Qsp600U4gxA0ojgidjS7CKkg.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-6531e45c-c973-467c-be46-1ed658d9a498\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-7cb3aea7-3da7-4fba-a8fe-ad6a36864b8f\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31ad-63fc-11ee-bb49-6369cd0cc946\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9a7dadef-740e-4d13-af2a-f1060ef7973d\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31ae-63fc-11ee-bb49-7d53f44011e4\">결론은 저도 지금 &quot;해야지&quot; 병에 걸린 환자라는 의미입니다. 하지만 전 방금 치료 되었어요. 이 글이 올라갔다는건 첫번째 &quot;해야지&quot; 병을 치료했다는 의미일 거구요. 두번째로, 블로그 강의는 일요일이면 수정이 거의다 완료 됩니다. (일주일간 편집기간이 끝나면 수강생분들 기준 다음주면 수정된걸 보실수 있을거예요) 마지막으로 플레이스 강의는 아직 공지 조차 못 올렸는데요. 그건 오늘 알려드릴 이 방법으로 바로 치료에 들어갈 예정입니다. 일단 그 방법을 알려드릴게요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4a5434a7-df8a-4b24-87b8-4e59cb14cfbd\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31af-63fc-11ee-bb49-6db676bcd900\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-3db34f20-0db4-4313-8879-671c035bd796\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b0-63fc-11ee-bb49-d15f87874173\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-c0713f56-f1dc-49ce-9bfd-47cdc8bc3832\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b1-63fc-11ee-bb49-2ff4c75977b8\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-fb67eead-2933-44e9-b3d4-1c47e31bfa1f\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b2-63fc-11ee-bb49-cd4de996395c\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-8120b0cd-71cd-42f1-9a93-b5610ec89a8f\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b3-63fc-11ee-bb49-57ef9eb6daf9\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-10b36727-3ae0-41f8-b897-9b0dfccafa26\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b4-63fc-11ee-bb49-4b616a839e7b\">그 방법은 &#x27;번개치기&#x27; 입니다. 번개치기가 뭐냐면, 벼락치기보다 더 센거예요 ㅋㅋㅋㅋㅋㅋㅋㅋㅋ어릴때 벼락치기 많이 하셨죠? 그겁니다. 근데 그걸 더더더 촉박하게 시간을 잡아두고 그 시간까지 미친듯이 하는겁니다. 지금 제가 이 글도 &#x27;번개치기&#x27;로 하고 있어요. 제가 지금 이 글을 쓰기 시작한 시간은 오후 12시 20분 입니다. 근데 제가 12시 50분에 필라테스 수업을 예약해 놨어요. 지금 사무실인데, 사무실에서 필라테스까지 가는데 5분이 걸려요. 그럼 저는 45분에 글을 끝내야겠죠? 지금 여기까지 쓰니깐 벌써 39분이네요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a1df194e-47bb-4780-9fd3-256b1776dde5\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b5-63fc-11ee-bb49-5573bdc1e792\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5903af46-1533-44c2-851d-0183eda6187f\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b6-63fc-11ee-bb49-bfaf33b06e72\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4a6d6643-818b-4ba1-90b1-5b6e79922f0a\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b7-63fc-11ee-bb49-fdfddaadfed0\">번개치기를 하면 장점은 시간이 촉박해서 미친듯이 할수 있어요. 저도 어제 이 글을 쓰려고 2시간을 생각했는데, 못쓰고 오늘 새로 썼습니다. 근데 지금 완성했거든요. 물론 어제 글보다 더 마음에 안듭니다. 근데 그냥 발행하려구요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f20b64a4-4a0e-4b30-a130-8b7a94840c7a\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b8-63fc-11ee-bb49-399d43e4f266\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-a8a27626-8936-4cfa-94c9-a2220ce18e0d\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31b9-63fc-11ee-bb49-534b5cccfd75\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-57895558-700e-4316-bf34-d7514bfe495b\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31ba-63fc-11ee-bb49-db81fee48c0b\">물론 번개치기의 단점도 있습니다. 바로 수정할게 많다는 거죠. 빨리했으니깐 당연한거죠. 근데 그럼 어떤가요? 수정하면 되죠. 지금 이 글도 수정할게 많네요;; </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-583eb1c4-83ca-49c6-b413-cc189dcfa263\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31bb-63fc-11ee-bb49-fd0f5e83b0d9\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-1069a2ed-a9fc-47c4-b9bf-d339dba8094c\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31bc-63fc-11ee-bb49-8d81dee87942\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4da64c48-69ff-4dd6-827a-c9fb51f896ef\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31bd-63fc-11ee-bb49-29807f64ca01\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d5b5cd7f-0113-45d6-bc14-7b3a93087a3e\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31be-63fc-11ee-bb49-076695a7a400\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-bbb0c705-19e2-491c-a661-41454fa56425\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31bf-63fc-11ee-bb49-b3034198836b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-345146b0-cae2-4433-a9c3-0adba9eb8614\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c0-63fc-11ee-bb49-4d2b0ce0bd93\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b2b9e389-b300-4499-827c-bd674f01ec17\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c1-63fc-11ee-bb49-5f2e19eac39c\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b8b8da0a-6d26-4252-9e8c-45fc8f4953c9\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c2-63fc-11ee-bb49-57b4fe706534\">지금 43분이라 마무리 지어야 하는데요. 이 글을 쓰다보니 또 아이디어가 생각났어요. 지금 제 블로그 강의 수강생 분이 500명이 넘고, 플레이스 강의 수강생 분이 100분이 넘는데요. 다들 &quot;해야지&quot; 병에 걸리신것 같아서 이걸 이 &#x27;번개치기&#x27; 로 치료해 드려야 겠어요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2e62fc21-5eae-4a13-b950-5a94ff5f5ef7\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c3-63fc-11ee-bb49-7b770080005a\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cfbf6ae5-f333-43cb-a3d0-fd782e4eaf14\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c4-63fc-11ee-bb49-0f4a69d25f37\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2bec54d4-2f96-4305-a46a-6cf6045d4e3b\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c5-63fc-11ee-bb49-a1bd2f0b760f\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-4ad36a98-c6da-4cd0-846d-53d2b1276e34\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c6-63fc-11ee-bb49-33fae9f22311\">옛날에 제가 학원할때 했던건데, &#x27;번개치기 스터디&#x27;라고 해서 애들을 방 하나에 다 가둬놓고 공부 다 안하면 안 내보냈거든요ㅋㅋㅋㅋ 그렇게 아예 가둬놓고 &#x27;번개치기 스터디&#x27; 로 시간 정해놓고 플레이스랑 블로그를 한 일주일간 빡시게 해보는거죠. 마케팅 대행사 창업반 어떻게 할지 고민하고 있었는데, 이렇게 하면 되겠어요. 이 아이디어는 좀더 디벨롭 해서 다시 글을 써보겠습니다.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-2b987abf-a88d-425b-bbb9-ab3aa0b01b33\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c7-63fc-11ee-bb49-5d0d9b0190a4\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-731b9b1a-deda-4fc6-9d5f-7be530b5db4b\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c8-63fc-11ee-bb49-adcac6938d48\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-bd44c2b9-0674-463f-930b-18a8b073f524\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31c9-63fc-11ee-bb49-f36073a9a6e8\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-f18616a4-9df2-4e62-a198-24f05cee9f4b\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31ca-63fc-11ee-bb49-c54d2515cb38\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e57553c1-7349-4057-b193-764739089450\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31cb-63fc-11ee-bb49-058f7cc67ada\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-44224d3d-0447-44b0-919d-3b63c6cbb38e\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31cc-63fc-11ee-bb49-9d77f37742a8\">여러분은 어떤 &quot;해야지&quot; 병에 걸리셨나요? 고치고 싶다면 언제 벼락치기를 할건지 오늘 당장 언제 할건지 &#x27;데일리 선언하기&#x27;를 해보시는건 어떨까요?</span><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31cd-63fc-11ee-bb49-37d762fff903\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-dc438246-149e-4358-b5d1-301547486a26\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31ce-63fc-11ee-bb49-f98c71fe0b1a\">​</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-292d1f32-68fc-42ba-95ad-473b8d3a5a9d\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:275px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-292d1f32-68fc-42ba-95ad-473b8d3a5a9d\", \"src\" : \"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfMjc3/MDAxNjk2NTYzOTA1MDI5.efyNwQw21Yoiv_6Ng1MgVLlMVCa9_-9hKgKOahRJrgkg.2ZT0DKzgmyafZWuA_rGaiFrfpMIAff6igwqGquSmVeMg.PNG/image.png\", \"originalWidth\" : \"275\", \"originalHeight\" : \"364\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://cafeptthumb-phinf.pstatic.net/MjAyMzEwMDZfMjc3/MDAxNjk2NTYzOTA1MDI5.efyNwQw21Yoiv_6Ng1MgVLlMVCa9_-9hKgKOahRJrgkg.2ZT0DKzgmyafZWuA_rGaiFrfpMIAff6igwqGquSmVeMg.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-1a535ea1-cdfd-4211-bd70-6e5fe4d51fda\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-fc833a0b-d869-44ff-a36d-3c30d073eb59\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31cf-63fc-11ee-bb49-8f30a08949bb\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d868ecaf-387f-4051-b525-a1a67f98c54c\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31d0-63fc-11ee-bb49-d5d365b1e293\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d6823fab-c3f4-4ee0-bde9-8d2119fb6a94\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-2cbf31d1-63fc-11ee-bb49-c3d5147a00e9\">앗 49분이네요. 필라테스 늦었으니 일단 발행하고 나중에 수정하도록 하겠습니다. 뿅</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>    </div>\n</div>\n",
