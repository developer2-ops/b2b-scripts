  "contentHtml": "<div class=\"se-viewer se-theme-default\" lang=\"ko-KR\">\n    <!-- SE_DOC_HEADER_START -->\n    <!--@CONTENTS_HEADER-->\n    <!-- SE_DOC_HEADER_END -->\n    <div class=\"se-main-container\">\n                <div class=\"se-component se-text se-l-default\" id=\"SE-ad47a92b-9ce1-4ce5-9954-2e28c2355a21\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-b3ce9ccd-fe42-455a-a0cb-394fa5051a1a\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-e217b3c7-e51d-46de-a955-32b5588811ad\">얼마전 이런 글을 올렸습니다. </span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-9015ff5d-c0dc-4754-9f55-be6a44fd0bda\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:702px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-9015ff5d-c0dc-4754-9f55-be6a44fd0bda\", \"src\" : \"https://cafeptthumb-phinf.pstatic.net/MjAyNDEwMTBfMTI1/MDAxNzI4NTQzMTQ5Mzkw.DfZTq-eyiQcad4UHIcbcNqEBzm4cmSnEu7ImJdKSr6kg.Y1Ethy-WLPGH9k5MmZtBa8UWGxxpRgWnwEW-yG1xMqkg.PNG/image.png\", \"originalWidth\" : \"702\", \"originalHeight\" : \"176\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://cafeptthumb-phinf.pstatic.net/MjAyNDEwMTBfMTI1/MDAxNzI4NTQzMTQ5Mzkw.DfZTq-eyiQcad4UHIcbcNqEBzm4cmSnEu7ImJdKSr6kg.Y1Ethy-WLPGH9k5MmZtBa8UWGxxpRgWnwEW-yG1xMqkg.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-2b85d4b5-68d2-4024-8357-d06cabacd16c\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-dda4822a-6513-4247-9bae-e2f15f64602e\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-5ccee276-2b5a-4b3c-8dab-0f3b93d1e515\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-003d0bac-6631-4809-8772-ccc007299433\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-f8f2c1e3-28ee-463d-a181-b7aaaedd1750\">그래서인지 부업스파르타반과 마케팅대행창업반 관련 문의도 많아졌구요. 대기 신청서에는 16분 정도 신청해주셨습니다. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5e77da9c-c31c-41e6-86ee-3848486b4b72\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-64591c24-0b35-45dc-9c27-ddd8f43f2da2\">​</span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>                <div class=\"se-component se-image se-l-default\" id=\"SE-93a1f331-ef8c-4df9-a9b2-34a12b7a54ee\">\n                    <div class=\"se-component-content se-component-content-normal\">\n                        <div class=\"se-section se-section-image se-l-default se-section-align-\" style=\"max-width:571px;\">\n                                <div class=\"se-module se-module-image\" style=\"\">\n                                    <a href=\"#\" class=\"se-module-image-link __se_image_link __se_link\" style=\"\" onclick=\"return false;\" data-linktype=\"img\" data-linkdata='{\"id\" : \"SE-93a1f331-ef8c-4df9-a9b2-34a12b7a54ee\", \"src\" : \"https://cafeptthumb-phinf.pstatic.net/MjAyNDEwMTBfMjQ4/MDAxNzI4NTQzMTM1NDI4.mjOfuy6kLVXep57aLt0uWG8S2mu7yuzAYs6LN5hTAr4g.SxIK8n9MoBR_PPGhXhcMeDj3qLoGs2ZRRGDIxWlAOvkg.PNG/image.png\", \"originalWidth\" : \"571\", \"originalHeight\" : \"149\", \"linkUse\" : \"false\", \"link\" : \"\"}'>\n                                        <img src=\"https://cafeptthumb-phinf.pstatic.net/MjAyNDEwMTBfMjQ4/MDAxNzI4NTQzMTM1NDI4.mjOfuy6kLVXep57aLt0uWG8S2mu7yuzAYs6LN5hTAr4g.SxIK8n9MoBR_PPGhXhcMeDj3qLoGs2ZRRGDIxWlAOvkg.PNG/image.png?type=w800\" alt=\"\" class=\"se-image-resource\" />\n                                    </a>\n                                </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"se-component se-text se-l-default\" id=\"SE-ebd8db2c-4e65-44a3-a5ca-fe0e87cf1e28\">\n                    <div class=\"se-component-content\">\n                        <div class=\"se-section se-section-text se-l-default\">\n                            <div class=\"se-module se-module-text\">\n                                    <!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-96e0fb63-509d-4a44-85bd-c55f7a133242\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-8c1c8bb5-bb53-4633-b6cb-c6bcb354971f\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-0777929f-5e50-4cfe-85d7-66f71527737d\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-c5a9c798-3a75-4c9b-a852-1787b53f6dd1\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-99bbe71d-1b4e-47f0-8e0f-d9c4fe5aa61e\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-52046733-dd97-4a73-bab1-5f449d71ff52\">먼저 죄송하다는 말씀드려요. 약속을 못 지킬것 같습니다. 제가 원래 올해 안으로 마케팅대행창업반과 부업스파르타반을 하려 했습니다. 근데 준비를 좀더 하고 싶어요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d2de4d4e-9ff7-4097-b9c2-6a69cd9fc0b5\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-699da146-98fe-4c77-acca-257a2077343a\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5f0e0bb7-0e38-4c94-a903-e52c8f2db619\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-d4f88594-15ee-4f1f-bb4e-4f483582e1f5\">사실 지금도 간판하는법 가르치는 것은 어렵지 않습니다. 마케팅 어떻게 하는지 알려드릴순 있는데요. 아마 그렇게 배운 분들이 수익을 달성하게 하는 것도 어렵지 않을겁니다. 들으신 분도 수익을 얻고 저도 돈 벌고 좋다고 생각했어요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-ec7ace73-da4d-4359-b681-efc9fd5eb95e\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-a5470ff5-05f6-42f0-9be9-aa333768cae5\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-478ec718-fde8-4bf0-9fe8-c6cadab290c3\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-e1310b93-c892-49b1-9837-4950ff886631\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-3f66e59e-0d12-4a3c-af73-d9e16df2fc0f\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-59ca261b-a6ae-40b1-91fc-169acdb55108\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-1ec2123c-1012-45cc-bba2-9ef0f76a4e9c\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-66e7a88f-81aa-4479-ab2f-dc9f5e985d36\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-d0d9398c-cd66-479a-9ab2-dc366305f3e6\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-b43498d5-2495-475a-921f-f70b51cbc415\">근데 저는 사실 이 반의 핵심은 &#x27;한번&#x27;이 아니라 &#x27;매달&#x27; 수입을 얻게하는거라고 생각하거든요. 부업스파르타 1기 수강생분중 제가 알기로는 수익을 얻었어도 지금까지 하는 분은 10%정도 입니다. 2기 수강생분도 그렇구요. 저는 이번 3기에서는 이 확률을 더 높이고 싶어요. 그러려면 제가 좀더 준비해 놓을것 들이 있어요.</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-1e7781ed-9f78-4ecb-9a89-464b6129f6b3\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-40f77a62-1f10-4568-ad27-110ef395495f\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-5b91b7cd-a07b-4277-8d8a-d964853825e1\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-970a2830-5420-4d7e-b2b6-a4ff498cb093\">강의를 하면서 준비해야지~ 생각했는데요. 근데 그건 아닌것 같아요. 제가 제대로 준비하고 알려드리는게 좋을것 같습니다. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-be70a3e2-77c7-4d12-ad15-7210be1ca3f6\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-b2517176-6b6a-46cc-837d-904f0f2b627b\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-9b2cb358-ae85-4b47-afce-add2328274da\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-ea6f21f5-8076-4938-8850-330a9c98bbf0\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-08169d6d-8fbe-4d74-8ff0-b4f3f2721b48\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-1986d64b-5ab0-4e51-8ebf-fe9d871c767e\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-03c228fb-d5c3-4c28-99cf-d10e96418581\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-860010fe-7bd7-4203-bb64-c920666d3135\">올해 안에 부업스파르타 / 마케팅대행창업반 하겠다는 약속 못 지켜서 죄송합니다. 근데 더 제대로 알려드리기 위함이니 제게 시간을 주세요. 제 목표는 3개월입니다. 3개월 안에 제 성과 다시 보여드릴게요. </span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-e3bcceec-7ee7-4bf7-8325-bbd0b9f13283\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-633127a8-8f9e-4b0e-9eb7-a12d77426278\">​</span></p><!-- } SE-TEXT --><!-- SE-TEXT { --><p class=\"se-text-paragraph se-text-paragraph-align- \" style=\"\" id=\"SE-cbe0ccb4-80f4-4098-8d26-b95614f18f58\"><span style=\"\" class=\"se-fs- se-ff-   \" id=\"SE-07af28c8-1a7c-4cc9-a1ab-d853558f5d0f\">대기신청서 작성해주신 분들에게는 너무 죄송하단 말씀드려요.  </span></p><!-- } SE-TEXT -->\n                            </div>\n                        </div>\n                    </div>\n                </div>    </div>\n</div>\n",
