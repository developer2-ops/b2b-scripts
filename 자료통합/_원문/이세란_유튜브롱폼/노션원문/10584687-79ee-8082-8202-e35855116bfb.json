      "version": 314,
      "type": "toggle",
      "properties": {
        "title": [
          [
            "어떤 치과나 할때 아래 사진 보여주시고, 안과 치과 부분 확대해주세요"
          ]
        ]
      },
      "content": [
        "598b5eb8-7681-4315-83ea-c37df2e30ef6",
        "791f66d8-ff0c-4099-b5f2-d1c34c10faee"
      ],
