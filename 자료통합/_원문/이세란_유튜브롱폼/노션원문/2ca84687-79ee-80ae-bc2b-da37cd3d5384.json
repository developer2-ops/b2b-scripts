      "version": 287,
      "type": "text",
      "properties": {
        "title": [
          [
            "그럼 컨텐츠에서 어떻게 커뮤니티를 모으냐? 3가지 조건이 필요함"
          ]
        ]
      },
      "parent_id": "2ca84687-79ee-80ae-bc2b-da37cd3d5384",
