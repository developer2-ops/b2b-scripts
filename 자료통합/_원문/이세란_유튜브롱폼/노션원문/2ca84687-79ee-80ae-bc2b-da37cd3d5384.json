    "2ca84687-79ee-80c1-9004-f1ab55e0f34b": {
      "id": "2ca84687-79ee-80c1-9004-f1ab55e0f34b",
      "version": 3,
      "type": "text",
      "parent_id": "2ca84687-79ee-80ae-bc2b-da37cd3d5384",
      "parent_table": "block",
      "alive": true,
      "created_time": 1765806024175,
      "last_edited_time": 1765806024177
