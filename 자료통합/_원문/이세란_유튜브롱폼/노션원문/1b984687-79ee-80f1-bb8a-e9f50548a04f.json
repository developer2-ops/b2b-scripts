    "1b984687-79ee-8061-9a3a-e177a40d92df": {
      "id": "1b984687-79ee-8061-9a3a-e177a40d92df",
      "version": 4,
      "type": "text",
      "parent_id": "1b984687-79ee-80f1-bb8a-e9f50548a04f",
      "parent_table": "block",
      "alive": true,
      "created_time": 1742215413414,
