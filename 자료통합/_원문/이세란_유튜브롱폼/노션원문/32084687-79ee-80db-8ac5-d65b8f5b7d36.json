    "32084687-79ee-804b-9cdf-fa1c0ed1082e": {
      "id": "32084687-79ee-804b-9cdf-fa1c0ed1082e",
      "version": 169,
      "type": "toggle",
      "properties": {
        "title": [
          [
            "말 끝나고 아래 영상에서 틀어주세요. 음식이랑 일상용품을 ~ 시작됏다 할때 바나나와 요거트 눌린 부분 보여주세요. "
          ]
        ]
      },
      "content": [
        "32084687-79ee-800b-a6da-ed71eb116875"
      ],
      "parent_id": "32084687-79ee-80db-8ac5-d65b8f5b7d36",
      "parent_table": "block",
      "alive": true,
      "created_time": 1773226076677,
      "last_edited_time": 1773226138403
    },
    "32084687-79ee-8080-952e-e85dee6efba3": {
      "id": "32084687-79ee-8080-952e-e85dee6efba3",
      "version": 3,
      "type": "text",
      "parent_id": "32084687-79ee-80db-8ac5-d65b8f5b7d36",
