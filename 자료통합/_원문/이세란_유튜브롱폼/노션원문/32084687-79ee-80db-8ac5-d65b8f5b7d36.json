      "id": "32084687-79ee-80d4-802a-ec7f9eae3fe8",
      "version": 275,
      "type": "toggle",
      "properties": {
        "title": [
          [
            "애초에 할때 영상 3개 전체 화면에 동시에 보여주세요"
          ]
        ]
      },
      "content": [
        "32084687-79ee-8067-8cd3-cea570fcb699",
        "32084687-79ee-80e7-b960-f6aa92ca3445",
        "32084687-79ee-8069-85ca-d27e8ce57b2b"
