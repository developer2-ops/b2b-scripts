      "id": "2ce84687-79ee-80b8-beaa-fa17e1f3866d",
      "version": 124,
      "type": "sub_sub_header",
      "properties": {
        "title": [
          [
            "사업시작\n"
          ]
        ]
      },
      "parent_id": "2ce84687-79ee-808e-94e3-c2d2223b8954",
