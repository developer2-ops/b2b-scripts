    "2ce84687-79ee-8008-a58a-f0e6c10c7db7": {
      "id": "2ce84687-79ee-8008-a58a-f0e6c10c7db7",
      "version": 14,
      "type": "text",
      "properties": {
        "title": [
          [
            "왜 시스템 에어컨을 하시는 건지 / 인터뷰1 00:22~01:21\n시스템 에어컨을 시작하신 계기 / 인터뷰1 01:22~02:06\n처음 배우실 때 어떠셨나요 / 인터뷰1 02:08~02:55\n기술을 잘 안 알려주던데 / 인터뷰1 02:58~03:42\n그 때 당시 하루 일하는 시간 / 인터뷰1 03:44~04:11\n어떻게 버티셨는지 / 인터뷰1 04:12~04:38\n"
          ]
        ]
      },
      "parent_id": "2ce84687-79ee-808e-94e3-c2d2223b8954",
      "parent_table": "block",
      "alive": true,
      "created_time": 1766110777548,
      "last_edited_time": 1766110793525
    },
    "2ce84687-79ee-809b-8b6f-e017b7e4f496": {
