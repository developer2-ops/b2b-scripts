      "version": 242,
      "type": "sub_sub_header",
      "properties": {
        "title": [
          [
            "탈북에서 대표까지"
          ]
        ]
      },
      "parent_id": "2ce84687-79ee-808e-94e3-c2d2223b8954",
      "parent_table": "block",
