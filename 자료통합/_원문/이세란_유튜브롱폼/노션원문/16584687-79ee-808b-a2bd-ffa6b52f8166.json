      "version": 1753,
      "type": "text",
      "properties": {
        "title": [
          [
            "자영업자에게는 시간과 수익은 비례합니다. "
          ]
        ]
      },
      "parent_id": "16584687-79ee-808b-a2bd-ffa6b52f8166",
