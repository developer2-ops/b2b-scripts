    "1d784687-79ee-807f-86d4-e91d961a86de": {
      "id": "1d784687-79ee-807f-86d4-e91d961a86de",
      "version": 6410,
      "type": "text",
      "properties": {
        "title": [
          [
            "이 일관성이 결정권자가 두명이면 지켜질 수가 없습니다. 일단 생각하는게 다를거구요. 그것 뿐 아니라 제가 마케팅을 할때 계속 원장님들한테 시스템 이런것 바꿔보자. 이런 카톡도 보내보자 이런 식으로 여러 제안을 하는데 그 이유가 유튜브나 블로그에서는 이런 사람이라고 화려하게 해놓고 막상 연락하면 앞뒤 안맞으면 그냥 매출이 안올라요. 그럼 문의는 오질라게 받는데 매출이 안올라요. 솔직히 그럼 저희도 완전 동기부여 안되고 아무리 돈 받았지만 마음이 덜 갈수 밖에  "
          ]
        ]
      },
      "parent_id": "1d284687-79ee-80b2-98b5-e6490af0cd90",
      "parent_table": "block",
      "alive": true,
      "created_time": 1744789807566,
      "last_edited_time": 1744790793947
    },
    "1d784687-79ee-8055-8529-ebd2bfebfbc2": {
      "id": "1d784687-79ee-8055-8529-ebd2bfebfbc2",
