    "1d784687-79ee-8008-8a41-fc7af8589502": {
      "id": "1d784687-79ee-8008-8a41-fc7af8589502",
      "version": 2845,
      "type": "text",
      "properties": {
        "title": [
          [
            "그래서 진짜 자수성가한 대표님은 그 배우자부터 그 가족과의 관계부터 좀 다르다는 느낌이 들었어요. 의견을 이야기 하지만 결정권이 정확히 한명에게 있다는 느낌이 듭니다. 강압적으로 “내말 들어” 이런게 아니고 내 의견이 다르더라도 충분히 이 사람이 고려해서 결정했을거라는 서로간의 믿음이 있는거죠. 저도 그렇지만 사실 같이 일해보면 이사람이 정말 좋은사람인지 느껴지잖아요. 배우자면 더 느껴지는것 같아요. 아 이사람이 진짜 괜찮은 사람이구나. 저도 같이 일해보면서 확실히 아니라는 생각이 들어서 전 남자친구와는 헤어졌"
          ]
        ]
      },
      "parent_id": "1d284687-79ee-80b2-98b5-e6490af0cd90",
      "parent_table": "block",
      "alive": true,
      "created_time": 1744790863543,
      "last_edited_time": 1744795237108
    },
    "1d784687-79ee-80dd-b489-c3ca8698571b": {
      "id": "1d784687-79ee-80dd-b489-c3ca8698571b",
