      "version": 4,
      "type": "numbered_list",
      "properties": {
        "title": [
          [
            "인터뷰 전체 내용은 아래처럼 위에 상단에 놓고 해당 부분일때마다 움직이는 것까지 해주시면 좋습니다, 색상톤은 위 2개로 맞춰주시면 좋습니다"
          ]
        ]
      },
      "format": {
